generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Prisma data models for OnSite360 construction management system

// Relation examples:
// 1. One-to-one: User and Profile (User has one Profile, Profile belongs to one User)
// 2. One-to-many: Project and Documents (Project has many Documents, Document belongs to one Project)
// 3. Many-to-many (implicit): Project and User (Project has many Users, User works on many Projects)
// 4. Many-to-many (explicit): Role and Permission via RolePermission junction table with metadata

// User model for storing user information
model User {
  id               String              @id @default(uuid())
  firstName        String
  lastName         String?
  email            String              @unique
  password         String // Hashed password
  roleId           String
  role             Role                @relation(fields: [roleId], references: [id])
  tasks            Task[] // Tasks assigned to the user
  threads          Thread[]
  messages         Message[]
  userProjects     UserProject[] // Explicit many-to-many relationship with projects
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  dailyLogs        DailyLog[]
  reportedIssues   Issue[] // Issues reported by the user
  taggedInIssues   Issue[]             @relation("IssueTaggedUsers") // Issues where the user is tagged
  documents        Document[]
  requestedRFIs    RFI[]               @relation("RFIRequester") // RFIs requested by this user
  assignedRFIs     RFI[]               @relation("RFIAssignee") // RFIs assigned to this user
  comments         Comment[] // Comments made by this user
  scheduleEvents   ScheduleEvent[]     @relation("EventAssignees") // Events assigned to this user
  createdEvents    ScheduleEvent[]     @relation("EventCreator") // Events created by this user
  markedAttendance ProjectAttendance[] // Attendance records marked by this user
}

// Role model for grouping users (e.g., Admin, Site Worker)
model Role {
  id              String           @id @default(uuid())
  name            String           @unique // e.g., Admin, Site Worker, Inspector
  users           User[] // Users with this role
  rolePermissions RolePermission[] // Many-to-many relationship with permissions
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// Permission model for fine-grained access control
model Permission {
  id              String           @id @default(uuid())
  pageId          String           @unique // Matches pageId from permission structure (e.g., 'document-management')
  pageName        String // Human-readable name (e.g., 'Document Management')
  description     String? // Description of the permission
  components      String[] // Array of component IDs this permission applies to
  rolePermissions RolePermission[] // Many-to-many relationship with roles
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// Junction table for many-to-many relationship between Role and Permission
model RolePermission {
  id                  String     @id @default(uuid())
  roleId              String
  permissionId        String
  role                Role       @relation(fields: [roleId], references: [id])
  permission          Permission @relation(fields: [permissionId], references: [id])
  // Permission level for this role-permission combination
  // 0 = None (No access at all)
  // 1 = Read-only (Can view/list but cannot make changes)
  // 2 = Write (Can create and update, but cannot delete)
  // 3 = Admin (Full access: create, update, delete)
  level               Int        @default(0)
  availableComponents String[] // Array of component IDs this permission applies to
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@unique([roleId, permissionId])
}

// Project model for construction projects
model Project {
  id                  String                @id @default(uuid())
  name                String
  description         String?
  type                String? // e.g., "Residential", "Commercial", "Industrial"
  budget              Float? // Project budget amount
  squareFeet          Float? // Square footage of the project
  location            String? // Address or description of location
  coordinates         Json? // Stores latitude/longitude as JSON: { "lat": 40.7128, "lng": -74.0060 }
  logoUrl             String? // URL to project logo image
  featuredImageUrl    String? // URL to featured/header image
  startDate           DateTime?
  endDate             DateTime?
  documents           Document[] // Documents associated with the project
  tasks               Task[] // Tasks for the project
  userProjects        UserProject[] // Explicit many-to-many relationship with users
  threads             Thread[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  MaterialStock       MaterialStock[]
  MaterialUsage       MaterialUsage[]
  DailyLog            DailyLog[]
  issue               Issue[]
  CrewAssignment      CrewAssignment[]
  ScheduleEvent       ScheduleEvent[]
  ProjectPhase        ProjectPhase[]
  EquipmentAssignment EquipmentAssignment[]
  RFI                 RFI[]
  attendance          ProjectAttendance[]
}

// Junction table for many-to-many relationship between User and Project
model UserProject {
  id               String    @id @default(uuid())
  userId           String
  projectId        String
  user             User      @relation(fields: [userId], references: [id])
  project          Project   @relation(fields: [projectId], references: [id])
  // Role/position of user in this specific project
  projectRole      String? // e.g., "Site Manager", "Foreman", "Supervisor", "Worker"
  // Access level for this user on this project
  accessLevel      Int       @default(0) // 0 = None, 1 = Read-only, 2 = Write, 3 = Admin
  // Assignment details
  assignedDate     DateTime  @default(now())
  endDate          DateTime? // When assignment ends (null for ongoing)
  isActive         Boolean   @default(true)
  // Work schedule
  workSchedule     String? // e.g., "Full-time", "Part-time", "Contractor"
  hourlyRate       Float? // If applicable
  // Contact and emergency info for this project
  emergencyContact String?
  // Notes about this assignment
  notes            String?
  // Who assigned this user to the project
  assignedBy       String? // User ID of who made the assignment
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, projectId])
}

// Document model for storing document metadata
model Document {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  name         String // e.g., 'Invoice.pdf'
  url          String // S3 URL for the file
  /// Describes the document type with the following possible values:
  /// - "Drawing": Architectural, structural, MEP, shop drawings
  /// - "Specification": Material specs, technical sheets, standards
  /// - "Contract": General contracts, subcontracts, change orders
  /// - "Permit": Construction, zoning, occupancy, safety permits
  /// - "Report": Daily logs, inspection reports, meeting minutes
  /// - "Submittal": Materials, samples, shop drawings for review/approval
  /// - "Invoice": Payment applications, bills, purchase-related documents
  /// - "Photo": Progress photos, defect documentation, site conditions
  type         String // e.g., "Drawing", "Specification", "Contract", "Photo"
  category     String? // Further categorization
  version      String   @default("1.0") // Document version
  size         Int? // File size in bytes
  mimeType     String? // File MIME type
  uploadedById String?
  uploader     User?    @relation(fields: [uploadedById], references: [id])
  description  String?
  tags         String[] // Array of tags
  isActive     Boolean  @default(true)
  tasks        Task[] // Tasks that reference this document as an attachment
  rfis         RFI[] // RFIs that reference this document as an attachment
  issues       Issue[] // Issues that reference this document as an attachment
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Task model for task management
model Task {
  id             String     @id @default(uuid())
  projectId      String
  project        Project    @relation(fields: [projectId], references: [id])
  title          String
  description    String?
  assigneeId     String?
  assignee       User?      @relation(fields: [assigneeId], references: [id])
  status         String     @default("Pending") // "Pending", "In Progress", "Completed", "Cancelled"
  priority       String     @default("Medium") // "Low", "Medium", "High", "Critical"
  progress       Float      @default(0) // 0-100 percentage
  estimatedHours Float?
  actualHours    Float?
  dueDate        DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  tags           String[] // Array of tags
  attachments    Document[] // Array of Document IDs for attachments
  comments       Comment[] // Comments on this task

  // NEW: link a task to a project phase (optional)
  projectPhaseId String? 
  projectPhase   ProjectPhase? @relation(fields: [projectPhaseId], references: [id])

  // NEW: daily activities that reference this task
  dailyActivities DailyActivity[] 

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

// Comment model for task comments
model Comment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// RFI model for formal information requests
model RFI {
  id            String     @id @default(uuid())
  projectId     String
  project       Project    @relation(fields: [projectId], references: [id])
  title         String
  description   String
  category      String // e.g., "Design", "Specification", "Clarification"
  priority      String     @default("Medium") // "Low", "Medium", "High", "Urgent"
  status        String     @default("Open") // "Open", "In Review", "Answered", "Closed"
  requestedById String?
  requester     User?      @relation("RFIRequester", fields: [requestedById], references: [id])
  assignees     User[]     @relation("RFIAssignee")
  threadId      String? // Link to discussion thread
  thread        Thread?    @relation(fields: [threadId], references: [id])
  documents     Document[] // Array of Document IDs for attachments
  dueDate       DateTime?
  answeredAt    DateTime?
  answer        String? // The response/answer
  attachments   String[] // Array of S3 URLs
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

// Thread model for message threads
model Thread {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  title       String // e.g., 'Site Inspection Discussion'
  description String? // Optional description
  type        String    @default("General") // "General", "RFI", "Issue", "Task"
  status      String    @default("Active") // "Active", "Closed", "Archived"
  isPrivate   Boolean   @default(false) // Private threads for sensitive discussions
  tags        String[] // Array of tags for categorization
  messages    Message[] // Messages in this thread
  users       User[]
  rfis        RFI[] // RFIs can reference threads
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Message model for internal communication
model Message {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id])
  content    String
  threadId   String?
  thread     Thread?  @relation(fields: [threadId], references: [id])
  attachment String? // S3 URL for attachments
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Material categories (cement, pipes, bricks, etc.)
model MaterialCategory {
  id          String     @id @default(uuid())
  name        String     @unique // e.g., "Cement", "Pipes", "Bricks"
  description String?
  materials   Material[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// Individual materials
model Material {
  id          String           @id @default(uuid())
  name        String // e.g., "Portland Cement 50kg"
  categoryId  String
  category    MaterialCategory @relation(fields: [categoryId], references: [id])
  unit        String // e.g., "bags", "meters", "pieces"
  description String?
  stocks      MaterialStock[]
  usages      MaterialUsage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// Material stock per project
model MaterialStock {
  id               String    @id @default(uuid())
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id])
  materialId       String
  material         Material  @relation(fields: [materialId], references: [id])
  currentQuantity  Float     @default(0)
  minimumThreshold Float? // Alert when stock goes below this
  maximumCapacity  Float? // Maximum storage capacity
  location         String? // Where it's stored on site
  lastRestocked    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([projectId, materialId])
}

// Material usage tracking
model MaterialUsage {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  quantity   Float
  usedBy     String // Who used it (crew member name)
  purpose    String? // What it was used for
  usageDate  DateTime @default(now())
  createdAt  DateTime @default(now())
}

// Daily work logs
model DailyLog {
  id             String          @id @default(uuid())
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id])
  date           DateTime        @db.Date
  weather        String? // Weather conditions
  temperature    String? // Temperature range
  workHours      Float? // Total work hours for the day
  workersPresent Int? // Number of workers present
  summary        String // Summary of work done
  issues         String? // Any issues encountered
  notes          String? // Additional notes
  loggedById     String
  logger         User            @relation(fields: [loggedById], references: [id])
  activities     DailyActivity[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([projectId, date])
}

// Activities within a daily log
model DailyActivity {
  id          String       @id @default(uuid())
  dailyLogId  String
  dailyLog    DailyLog     @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  activity    String // Description of activity
  location    String? // Where the activity took place

  // NEW: optional association to a Task
  taskId      String?
  task        Task?       @relation(fields: [taskId], references: [id])

  crewMembers CrewMember[]
  startTime   DateTime?
  endTime     DateTime?
  progress    Float? // Percentage completed (0-100)
  notes       String?
  status      String       @default("IN_PROGRESS") // "Planned", "In Progress", "Completed", "Delayed"
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// Issue tracking
model Issue {
  id           String     @id @default(uuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id])
  title        String
  description  String
  category     String // e.g., "Safety", "Quality", "Delay", "Equipment"
  severity     String // e.g., "Low", "Medium", "High", "Critical"
  status       String     @default("Open") // "Open", "In Progress", "Resolved", "Closed"
  location     String? // Where the issue occurred
  reportedBy   String // Name of person who reported
  reportedById String?
  reporter     User?      @relation(fields: [reportedById], references: [id])
  taggedUsers  User[]     @relation("IssueTaggedUsers") // Users tagged to this issue for notifications
  dueDate      DateTime?
  resolvedAt   DateTime?
  resolution   String? // How the issue was resolved
  attachments  Document[] // Array of Document IDs for attachments
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// Project-based attendance tracking
model ProjectAttendance {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  date      DateTime @db.Date

  // Work schedule information
  actualStartTime DateTime? // When work actually started
  workDelayed     Boolean   @default(false)
  delayReason     String?
  delayDuration   Int? // Delay in minutes

  // Marked attendance
  markedById String
  markedBy   User   @relation(fields: [markedById], references: [id])

  // Day type information
  dayType       String  @default("WORKDAY") // "WORKDAY", "HOLIDAY", "WEEKEND", "WEATHER_DELAY", "NO_WORK_SCHEDULED"
  dayTypeReason String? // Holiday name, weather condition, etc.
  isWorkDay     Boolean @default(true) // Whether work was scheduled for this day

  // Many-to-many relationship with crew members
  crewAttendance AttendanceRecord[]

  // General notes for the day
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, date]) // One attendance record per project per day
}

// Individual crew member attendance within a project attendance
model AttendanceRecord {
  id                  String            @id @default(uuid())
  projectAttendanceId String
  projectAttendance   ProjectAttendance @relation(fields: [projectAttendanceId], references: [id], onDelete: Cascade)
  crewMemberId        String
  crewMember          CrewMember        @relation(fields: [crewMemberId], references: [id])

  // Attendance status
  status String // "PRESENT", "ABSENT", "HALF_DAY", "LATE", "EARLY_DEPARTURE", "SICK_LEAVE", "VACATION", "HOLIDAY"

  // Time tracking
  checkInTime    DateTime?
  checkOutTime   DateTime?
  breakDuration  Int? // Break duration in minutes
  totalHours     Float? // Total working hours
  scheduledHours Float? // Scheduled hours for the day

  // Leave/absence details
  leaveType  String? // "SICK", "VACATION", "PERSONAL", "EMERGENCY", "UNAUTHORIZED"
  isApproved Boolean? // Whether leave was pre-approved

  // Work details
  workLocation String? // Specific area where they worked
  tasks        String[] // Array of tasks/activities performed

  // Individual notes for this crew member
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectAttendanceId, crewMemberId]) // One record per crew member per project attendance
}

// Crew members (non-system users)
model CrewMember {
  id                String             @id @default(uuid())
  name              String
  role              String // e.g., "Foreman", "Electrician", "Carpenter"
  phone             String?
  email             String?
  skills            String[] // Array of skills
  isActive          Boolean            @default(true)
  hireDate          DateTime?
  assignments       CrewAssignment[]
  dailyActivities   DailyActivity[]
  attendanceRecords AttendanceRecord[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

// Crew assignments to projects
model CrewAssignment {
  id           String     @id @default(uuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id])
  crewMemberId String
  crewMember   CrewMember @relation(fields: [crewMemberId], references: [id])
  assignedDate DateTime   @default(now())
  endDate      DateTime?
  isActive     Boolean    @default(true)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([projectId, crewMemberId])
}

// Schedule events (milestones, tasks, meetings)
model ScheduleEvent {
  id           String          @id @default(uuid())
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id])
  title        String
  description  String?
  type         String // e.g., "Milestone", "Task", "Meeting", "Delivery", "Inspection"
  startDate    DateTime
  endDate      DateTime?
  allDay       Boolean         @default(false)
  location     String?
  assignees    User[]          @relation("EventAssignees") // Users assigned to this event
  status       String          @default("Scheduled") // "Scheduled", "In Progress", "Completed", "Cancelled"
  priority     String          @default("Medium") // "Low", "Medium", "High"
  color        String? // For calendar display
  recurrence   Json? // Recurrence rules if applicable
  dependencies ScheduleEvent[] @relation("EventDependencies")
  dependents   ScheduleEvent[] @relation("EventDependencies")
  notes        String?
  createdById  String // User who created the event
  createdBy    User            @relation("EventCreator", fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

// Project phases for Gantt chart
model ProjectPhase {
  id          String         @id @default(uuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id])
  name        String // e.g., "Foundation", "Framing", "Electrical"
  description String?
  startDate   DateTime
  endDate     DateTime
  progress    Float          @default(0) // Percentage completed (0-100)
  order       Int // Display order
  parentId    String? // For sub-phases
  parent      ProjectPhase?  @relation("PhaseHierarchy", fields: [parentId], references: [id])
  children    ProjectPhase[] @relation("PhaseHierarchy")
  color       String? // For Gantt chart display
  isActive    Boolean        @default(true)

  // NEW: tasks belonging to this phase
  tasks       Task[] 

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// Equipment and tools
model Equipment {
  id              String                @id @default(uuid())
  name            String
  type            String // e.g., "Heavy Machinery", "Hand Tools", "Safety Equipment"
  model           String?
  serialNumber    String?
  status          String                @default("Available") // "Available", "In Use", "Maintenance", "Out of Service"
  location        String?
  purchaseDate    DateTime?
  warrantyExpiry  DateTime?
  notes           String?
  maintenanceLogs MaintenanceLog[]
  assignments     EquipmentAssignment[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

// Equipment assignments to projects
model EquipmentAssignment {
  id           String    @id @default(uuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id])
  equipmentId  String
  equipment    Equipment @relation(fields: [equipmentId], references: [id])
  assignedDate DateTime  @default(now())
  returnDate   DateTime?
  assignedTo   String? // Crew member responsible
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Equipment maintenance logs
model MaintenanceLog {
  id          String    @id @default(uuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  type        String // e.g., "Routine", "Repair", "Inspection"
  description String
  performedBy String // Who performed the maintenance
  date        DateTime  @default(now())
  cost        Float?
  nextDue     DateTime? // When next maintenance is due
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
